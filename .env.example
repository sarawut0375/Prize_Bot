# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามจริง
# cp .env.example .env

# --- Telegram Bot ---
# วิธีได้มา: คุยกับ @BotFather บน Telegram -> /newbot -> รับ token
TELEGRAM_BOT_TOKEN=
# ส่งข้อความอะไรก็ได้ให้บอทก่อน แล้วเปิด
# https://api.telegram.org/bot<TOKEN>/getUpdates เพื่อหา chat id
TELEGRAM_CHAT_ID=

# --- ความถี่ในการตรวจราคา (นาที) ---
# คำเตือน: ยิ่งถี่ ยิ่งเสี่ยงโดน Shopee/Lazada บล็อก IP เพราะเข้าไปถี่เกินไป (ดู README)
SCRAPE_INTERVAL_MINUTES=5

# --- Database (ค่าเริ่มต้นคือไฟล์ SQLite ในโปรเจกต์ ไม่ต้องแก้ก็ได้) ---
# DATABASE_URL=sqlite:///price_bot.db

# --- Web server ---
HOST=0.0.0.0
PORT=8000
