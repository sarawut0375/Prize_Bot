# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามจริง
# cp .env.example .env

# --- Telegram Bot ---
# วิธีได้มา: คุยกับ @BotFather บน Telegram -> /newbot -> รับ token
TELEGRAM_BOT_TOKEN=
# ส่งข้อความอะไรก็ได้ให้บอทก่อน แล้วเปิด
# https://api.telegram.org/bot<TOKEN>/getUpdates เพื่อหา chat id
TELEGRAM_CHAT_ID=

# --- ความถี่ในการตรวจราคา (นาที) ---
# บอทจะสุ่มรอบเวลาระหว่างค่าต่ำสุด-สูงสุดนี้ทุกครั้ง (ไม่ใช่ตายตัว) เพื่อให้ดูไม่เหมือนบอท
# คำเตือน: ยิ่งถี่ (ตัวเลขน้อย) ยิ่งเสี่ยงโดน Shopee/Lazada บล็อก IP (ดู README)
SCRAPE_INTERVAL_MIN_MINUTES=10
SCRAPE_INTERVAL_MAX_MINUTES=30

# --- Database (ค่าเริ่มต้นคือไฟล์ SQLite ในโปรเจกต์ ไม่ต้องแก้ก็ได้) ---
# DATABASE_URL=sqlite:///price_bot.db

# --- Web server ---
HOST=0.0.0.0
PORT=8000
